<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="store_app.CartPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="CartItemsView"
                        SelectionMode="None"
                        Margin="20,18,20,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="0,0,0,16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Миний сагс"
                               Style="{StaticResource DisplayTitle}" />
                        <Label x:Name="CartHeaderLabel"
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                    <Border Padding="14"
                            BackgroundColor="{StaticResource BlueSoft}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0">
                        <Label x:Name="EarnPreviewLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="{StaticResource Ink}" />
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,0,0,12"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource SoftStroke}"
                            StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="76"
                                    HeightRequest="76"
                                    BackgroundColor="{StaticResource ProductImageSurface}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                <Image Source="{Binding Product.Image}"
                                       Aspect="AspectFit"
                                       Margin="8" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Product.Brand}"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedInk}" />
                                <Label Text="{Binding Product.Name}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding LinePointsText}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding LineTotalText}"
                                       Style="{StaticResource PriceText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="6"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center">
                                <Button Text="+"
                                        Clicked="OnIncreaseClicked"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        Padding="0"
                                        CornerRadius="17"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White" />
                                <Label Text="{Binding Quantity}"
                                       HorizontalTextAlignment="Center"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource Ink}" />
                                <Button Text="-"
                                        Clicked="OnDecreaseClicked"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        Padding="0"
                                        CornerRadius="17"
                                        BackgroundColor="{StaticResource ProductImageSurface}"
                                        TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1"
                Padding="20,16,20,20"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource SoftStroke}"
                StrokeShape="RoundRectangle 24,24,0,0">
            <VerticalStackLayout Spacing="12">
                <BoxView HeightRequest="4"
                         WidthRequest="52"
                         CornerRadius="2"
                         HorizontalOptions="Center"
                         BackgroundColor="{StaticResource SoftStroke}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Нийт"
                           Style="{StaticResource CardTitle}" />
                    <Label x:Name="CartTotalLabel"
                           Grid.Column="1"
                           Style="{StaticResource PriceText}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Авах loyalty оноо"
                           Style="{StaticResource MutedText}" />
                    <Label x:Name="CartPointLabel"
                           Grid.Column="1"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Primary}" />
                </Grid>
                <Border x:Name="UsePointsCard"
                        Padding="12"
                        BackgroundColor="{StaticResource ProductImageSurface}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="Оноо ашиглах"
                                   Style="{StaticResource CardTitle}" />
                            <Label x:Name="UsePointsHintLabel"
                                   Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Button x:Name="UsePointsButton"
                                Grid.Column="1"
                                Text="Ашиглах"
                                Clicked="OnUsePointsClicked"
                                HeightRequest="38"
                                MinimumHeightRequest="38"
                                Padding="12,0"
                                CornerRadius="15"
                                BackgroundColor="{StaticResource Surface}"
                                TextColor="{StaticResource Primary}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12" />
                    </Grid>
                </Border>
                <Grid x:Name="DiscountRow"
                      ColumnDefinitions="*,Auto">
                    <Label Text="Онооны хөнгөлөлт"
                           Style="{StaticResource MutedText}" />
                    <Label x:Name="CartDiscountLabel"
                           Grid.Column="1"
                           FontFamily="OpenSansSemibold"
                           TextColor="#EF4444" />
                </Grid>
                <Button Text="Захиалга үргэлжлүүлэх"
                        Clicked="OnCheckoutClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" />
            </VerticalStackLayout>
        </Border>

        <Grid x:Name="CheckoutOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              Opacity="0"
              Padding="24"
              BackgroundColor="#990F172A">
            <Border x:Name="CheckoutDialogCard"
                    Padding="22"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource SoftStroke}"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    MaximumWidthRequest="324"
                    Scale="0.96">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">
                        <Border x:Name="CheckoutDialogIcon"
                                WidthRequest="54"
                                HeightRequest="54"
                                BackgroundColor="{StaticResource BlueSoft}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                            <Label x:Name="CheckoutDialogIconLabel"
                                   Text="✓"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label x:Name="CheckoutDialogTitleLabel"
                                   Text="Захиалга баталгаажлаа"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="{StaticResource Ink}" />
                            <Label x:Name="CheckoutDialogMessageLabel"
                                   Text="Таны сагс амжилттай шинэчлэгдлээ."
                                   FontSize="13"
                                   TextColor="{StaticResource MutedInk}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="CheckoutDialogPointBadge"
                            Padding="14,12"
                            BackgroundColor="{StaticResource ProductImageSurface}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="Loyalty"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedInk}"
                                   VerticalTextAlignment="Center" />
                            <Label x:Name="CheckoutDialogPointLabel"
                                   Grid.Column="1"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>

                    <Button Text="OK"
                            Clicked="OnCheckoutDialogOkClicked"
                            HeightRequest="48"
                            CornerRadius="18"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontFamily="OpenSansSemibold" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
