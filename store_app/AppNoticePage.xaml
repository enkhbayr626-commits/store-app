<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="store_app.AppNoticePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid x:Name="Overlay"
          Opacity="0"
          Padding="24"
          BackgroundColor="#990F172A">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border x:Name="DialogCard"
                Padding="22"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource SoftStroke}"
                StrokeShape="RoundRectangle 26"
                StrokeThickness="1"
                MaximumWidthRequest="326"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Scale="0.96">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">
                    <Border WidthRequest="54"
                            HeightRequest="54"
                            BackgroundColor="{StaticResource BlueSoft}"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0">
                        <Label x:Name="IconLabel"
                               Text="✓"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label x:Name="TitleLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="{StaticResource Ink}"
                               LineBreakMode="WordWrap" />
                        <Label x:Name="MessageLabel"
                               FontSize="13"
                               TextColor="{StaticResource MutedInk}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="HighlightCard"
                        Padding="14,12"
                        BackgroundColor="{StaticResource ProductImageSurface}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                    <Label x:Name="HighlightLabel"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />
                </Border>

                <Button x:Name="OkButton"
                        Text="OK"
                        Clicked="OnOkClicked"
                        HeightRequest="48"
                        CornerRadius="18"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
